{
  "expo": {
    "name": "Lubist Mobile",
    "slug": "lubist-mobile-application",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#f3efe7"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Lubist uses your location to show salons near you."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f3efe7"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lubist uses your location to show salons near you."
        }
      ]
    ]
  }
}
