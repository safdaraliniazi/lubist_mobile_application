# Backend API base URL used by the mobile app.
#
# LOCAL DEV (expo start): optional. If unset, src/app/config/env.ts auto-detects
# your machine's LAN IP and talks to your local backend on port 8000. Set this
# only when you want `expo start` to hit a specific backend (e.g. production).
#
# REAL BUILDS (eas build): this file is NOT used — .env is gitignored and never
# reaches the EAS build server. Production/preview builds read the URL from the
# build profiles in eas.json instead.
EXPO_PUBLIC_API_URL=""
